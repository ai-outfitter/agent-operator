# syntax=docker/dockerfile:1.7
FROM --platform=$BUILDPLATFORM golang:1.26.0-bookworm AS build

ARG TARGETARCH
ARG TARGETOS

WORKDIR /src
COPY code/operator/go.mod code/operator/go.sum ./
RUN go mod download
COPY code/operator/ ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/manager ./cmd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/manager /bin/manager
USER 65532:65532
ENTRYPOINT ["/bin/manager"]
