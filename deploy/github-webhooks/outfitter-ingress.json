{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "github-events",
    "namespace": "org-outfitter",
    "annotations": {
      "cert-manager.io/cluster-issuer": "letsencrypt-cloudflare-dns"
    }
  },
  "spec": {
    "ingressClassName": "nginx",
    "rules": [
      {
        "host": "github-events-outfitter.unsupervised.wtf",
        "http": {
          "paths": [
            {
              "path": "/webhooks/github",
              "pathType": "Exact",
              "backend": {
                "service": {
                  "name": "forge-gateway",
                  "port": {
                    "number": 80
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "tls": [
      {
        "hosts": [
          "github-events-outfitter.unsupervised.wtf"
        ],
        "secretName": "github-events-tls"
      }
    ]
  }
}
